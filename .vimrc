" .vimrc: Default vim configurations

set expandtab                        " use spaces instead of tabs
set tabstop=2                        " use 2 spaces per tab
set shiftwidth=2                     " insert 2 spaces when using tab in new line
set list                             " show tab and trailing spaces
set listchars=tab:▶-,trail:•,nbsp:⎵  " list characters
set number                           " show line number column
set relativenumber                   " relative line number column
set splitbelow                       " open horizontal windows below current window
set splitright                       " open vertical windows to the right of current
set termguicolors                    " true color support

colorscheme sorbet                   " colorscheme
